#!/bin/bash
set -euo pipefail

# The image is mounted permanently at {{ env.mount }}, so users can't rely on
# `uenv start --view=...` to set up the environment. The helper scripts and the
# README source live in the recipe's extra/ path, copied to meta/extra.
extra={{ env.mount }}/meta/extra

# Activate scripts that apply the same environment changes as `uenv start --view=<view>`.
# Not the env/<view>/activate.sh generated by Spack: those reproduce Spack's build
# environment, not the filtered view environment in meta/env.json.
/usr/bin/python3 $extra/make-activate.py {{ env.mount }} \
    mch        {{ env.mount }}/activate-mch.sh \
    mch-serial {{ env.mount }}/activate-mch-serial.sh

# The user-facing README, rendered for the terminal: `cat {{ env.mount }}/README`.
/usr/bin/python3 $extra/render-readme.py $extra/README.md {{ env.mount }}/README
